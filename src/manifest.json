{
  "manifest_version": 3,
  "name": "AI Driven Chrome Extension (template)",
  "version": "0.1.0",
  "description": "TODO: 説明",
  "minimum_chrome_version": "120",
  "permissions": ["activeTab"],
  "commands": {
    "open-registration": {
      "suggested_key": { "default": "Ctrl+Shift+Y" },
      "description": "閲覧中のページのタスクを登録する"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/index.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-src 'none'; frame-ancestors 'none';"
  },
  "options_page": "options/index.html"
}
